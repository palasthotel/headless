{
  "name": "@palasthotel/headless",
  "version": "3.0.9",
  "description": "wp-rest extensions to works with headless plugin.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest",
    "lint": "tsc --noEmit",
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/palasthotel/headless"
  },
  "author": "Palasthotel GmbH",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  },
  "dependencies": {
    "@palasthotel/wp-rest": "^1.0.2",
    "@wordpress/editor": "^14.52.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.14.1",
    "npm": "11.11.0"
  }
}
